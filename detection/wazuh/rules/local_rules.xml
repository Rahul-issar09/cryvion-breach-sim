<!-- Cryvion custom detection rules. IDs in the 100100+ user range. -->
<group name="cryvion,attack,">

  <!-- Base: any decoded CryvionPortal security event -->
  <rule id="100100" level="0">
    <decoded_as>cryvion-sec</decoded_as>
    <description>CryvionPortal security event</description>
  </rule>

  <!-- SQL injection (T1190) -->
  <rule id="100110" level="10">
    <if_sid>100100</if_sid>
    <field name="crvevent">SQLI</field>
    <description>SQL injection attempt on CryvionPortal: $(detail)</description>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- Command injection / RCE (T1059) -->
  <rule id="100111" level="12">
    <if_sid>100100</if_sid>
    <field name="crvevent">RCE</field>
    <description>OS command injection / RCE on CryvionPortal: $(detail)</description>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- Single failed login (T1110) -->
  <rule id="100112" level="5">
    <if_sid>100100</if_sid>
    <field name="crvevent">LOGIN_FAILED</field>
    <description>Failed login to CryvionPortal (user: $(detail))</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- Brute force: many failed logins from one source (T1110) -->
  <rule id="100113" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100112</if_matched_sid>
    <same_source_ip />
    <description>Brute-force attack on CryvionPortal: repeated failed logins from $(srcip)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- File upload / possible web shell (T1505) -->
  <rule id="100114" level="8">
    <if_sid>100100</if_sid>
    <field name="crvevent">UPLOAD</field>
    <description>File uploaded to CryvionPortal (possible web shell): $(detail)</description>
    <mitre><id>T1505</id></mitre>
  </rule>

  <!-- Successful login (context/correlation) -->
  <rule id="100115" level="4">
    <if_sid>100100</if_sid>
    <field name="crvevent">LOGIN_SUCCESS</field>
    <description>Successful login to CryvionPortal (user: $(detail))</description>
  </rule>

</group>
