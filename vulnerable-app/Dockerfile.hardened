# CryvionPortal — HARDENED web tier (the "after" state).
# Same app code, but: non-root, minimal packages (no ssh/cron/ping post-exploit
# tooling), no on-disk creds file, DB password from a Docker secret, read-only
# rootfs at runtime. Fronted by a ModSecurity WAF in docker-compose.hardened.yml.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ /app/
COPY entrypoint.hardened.sh /entrypoint.sh
# Remove the planted credentials file; create a non-root user and writable dirs.
RUN rm -rf /app/config \
    && useradd -u 10001 -m appuser \
    && mkdir -p /app/uploads /var/log/cryvion \
    && chown -R appuser:appuser /app /var/log/cryvion \
    && chmod +x /entrypoint.sh

USER appuser
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "app.py"]
